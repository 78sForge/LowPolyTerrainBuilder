[sub_resource type="GDScript" id="GDScript_bosie"]
script/source = "extends Marker3D

@onready var player: CharacterBody3D = $Player

var speed := 5.0
var printed := false
func _physics_process(delta: float) -> void:
	speed += delta * 0.2
	rotate_y(-delta * speed)
	player.position.z += delta

	return
	if player.position.z < 20.0:
		player.position.z += delta
		rotate_y(-delta * speed)
	else:
		player.position.z += delta * 3.0
		if not printed:
			printed = true
			print(\"################# printed\")
	#player.position.y -= delta * 2.0
"

