[sub_resource type="GDScript" id="GDScript_bosie"]
script/source = "extends Marker3D

@onready var player: MeshInstance3D = $Player

func _physics_process(delta: float) -> void:
	rotate_y(-delta * 15.0)
	player.position.z += delta
	player.position.y += delta
"

