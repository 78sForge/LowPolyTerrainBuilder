[sub_resource type="GDScript" id="GDScript_u4ekj"]
script/source = "
extends MeshInstance3D

var time := 0.0
func _physics_process(delta: float) -> void:
	time += delta
	position.y = sin(time) * 2.0 * cos(time)
"

