[sub_resource type="GDScript" id="GDScript_i2a33"]
script/source = "
extends MeshInstance3D

var time := 10.0
func _physics_process(delta: float) -> void:
	time += delta
	position.y = sin(time) * 2.1 * cos(time)
"

